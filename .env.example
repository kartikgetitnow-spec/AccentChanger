# Gemini & Google Cloud API Configuration
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-3.1-flash-live-preview

# Voice Conversion (RVC) Settings
RVC_MODEL_PATH=models/rvc/trump_v2.pth
RVC_INDEX_PATH=models/rvc/trump_v2.index
RVC_INFERENCE_URL=

# Server & Real-time Audio Configuration
PORT=3000
WEBSOCKET_PORT=3000
AUDIO_SAMPLE_RATE=16000
MAX_CONCURRENT_SESSIONS=10
NODE_ENV=production

# Optional SSL / HTTPS Configuration (for direct WSS without reverse proxy)
# SSL_KEY_PATH=/etc/letsencrypt/live/domain/privkey.pem
# SSL_CRT_PATH=/etc/letsencrypt/live/domain/fullchain.pem
